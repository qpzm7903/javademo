<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.transaction_demo.domain.repository.ProductRepo">

    <resultMap id="product" type="com.example.transaction_demo.domain.model.Product">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="quantityInStock" column="quantity_in_stock"/>
    </resultMap>
    <insert id="createProduct">
        insert into mall_product (id, description, price, quantity_in_stock) values (#{product.id}, #{product.description},#{product.price},#{product.quantityInStock})
    </insert>
    <select id="listAllProduct" resultType="com.example.transaction_demo.domain.model.Product">
        select * from mall_product;
    </select>
</mapper>